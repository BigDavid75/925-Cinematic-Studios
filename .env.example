# --- Required for the real agent ---
ANTHROPIC_API_KEY=sk-ant-...

# Default chat model (Sonnet 5.5 matches the video's default)
DEFAULT_MODEL=claude-sonnet-5-5
TITLE_MODEL=claude-haiku-5-5

# --- Image / video engine (ComfyUI) ---
# Your Mac's ComfyUI exposed through a Cloudflare Tunnel, e.g. https://comfy.openartvision.com
COMFY_URL=http://127.0.0.1:8188
# Cloudflare Access service token (protects ComfyUI, which has no login of its own)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# --- Site protection ---
# Set this before going live, or anyone can spend your API credits.
SITE_PASSWORD=change-me
COOKIE_SECRET=replace-with-a-long-random-string

# Starting credit balance shown in the top bar
START_CREDITS=1000

# Where sessions, generated media, timelines and exports are stored (mount a persistent disk here in production)
DATA_DIR=data
# Only needed if ffmpeg/ffprobe are not on the PATH
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# MOCK=1 runs the full UI with a simulated agent and placeholder images and clips (no keys needed)
MOCK=0
PORT=3000
